{
  "name": "cardapio-digital",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:dashboard": "npm run dev --workspace apps/dashboard",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web && npm run build --workspace apps/dashboard",
    "test": "node tests/run.mjs",
    "test:api": "node tests/run.mjs api",
    "test:e2e": "node tests/run.mjs e2e",
    "carga": "node tests/run.mjs carga",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint . --max-warnings=1",
    "lint:report": "eslint . --max-warnings=1 -f json -o reports/eslint.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "lighthouse": "^12.8.2",
    "typescript-eslint": "^8.72.1"
  }
}
