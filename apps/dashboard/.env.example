# Public URL of the deployed API (no trailing slash). Inlined at build time — set it in the
# Vercel project's env vars *before* the first deploy. Local dev falls back to http://localhost:4100.
VITE_API_URL=https://your-api.vercel.app
# Public URL of the deployed cardápio (apps/web); used to build the table QR-code links.
# Local dev falls back to http://localhost:5173.
VITE_CUSTOMER_APP_URL=https://your-cardapio.vercel.app
