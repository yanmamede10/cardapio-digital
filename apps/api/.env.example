# Postgres. Runtime uses the POOLED (PgBouncer) string; migrations/seed use the DIRECT one.
# On Vercel + Neon: DATABASE_URL = pooled URL + "&pgbouncer=true&connect_timeout=15"
#                   DIRECT_URL   = the non-pooled URL (Neon's DATABASE_URL_UNPOOLED)
# Local dev: any Postgres, e.g.
#   docker run -d --name pg -e POSTGRES_PASSWORD=pw -e POSTGRES_DB=cardapio -p 5432:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:pw@localhost:5432/cardapio"
DIRECT_URL="postgresql://postgres:pw@localhost:5432/cardapio"
PORT=4100
# Required in production (the API refuses to start without it). Generate: openssl rand -base64 48
JWT_SECRET="dev-local-only-change-before-deploying"

# Comma-separated frontend origins allowed by CORS (dashboard + cardápio .vercel.app URLs).
# Unset = any origin (local dev).
# CORS_ORIGINS=https://your-dashboard.vercel.app,https://your-cardapio.vercel.app

# Supabase Storage (S3-compatible) — used for Aparência logo/cover and product photo uploads.
# Leave unset in dev if you don't need real uploads yet; the upload endpoints
# will respond 503 until these are filled in.
# Supabase dashboard: Project Settings → Storage → S3 Connection for endpoint/region,
# and create an access key pair there (not your service_role key).
# Create the bucket as PUBLIC (product/logo photos are meant to be publicly viewable).
STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_S3_REGION=<project-region, e.g. sa-east-1>
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_BUCKET=
# Public base URL the uploaded files are served from.
STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
# PRIVATE bucket for customers' WhatsApp photos and voice notes — never the public one above. The API stores the object key
# and hands out signed URLs valid 30–60 min. `npm run db:deploy` creates/aligns it (private, allowed types, size limit).
STORAGE_S3_WHATSAPP_BUCKET=whatsapp-media

# Super admin (/admin in the dashboard): the single key that unlocks restaurant sign-up/activation.
# Unset = /api/admin answers 503. Generate: openssl rand -base64 32
SUPER_ADMIN_KEY=

# WhatsApp in Atendimento — DEV ONLY for now (Evolution API, an unofficial connection). Start it with `docker compose up -d`
# at the repo root. Any of the four unset (as on Vercel) = connecting and sending answer 503.
EVOLUTION_API_URL=http://localhost:8085
# Same value as AUTHENTICATION_API_KEY in docker-compose.yml (default dev-evolution-key).
EVOLUTION_API_KEY=dev-evolution-key
# Where Evolution, inside Docker, posts incoming messages: this API on the host.
WHATSAPP_WEBHOOK_URL=http://host.docker.internal:4100/api/whatsapp/webhook
# Shared secret Evolution sends in the x-webhook-secret header; a webhook without it gets 401. Generate: openssl rand -hex 32
# Changed it (or the URL) with a number already connected? Disconnect and connect again so Evolution gets the new value.
WHATSAPP_WEBHOOK_SECRET=
