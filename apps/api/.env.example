# Dev settings. Production (the VM) has its own file: deploy/.env.example.
# Postgres. DATABASE_URL at runtime; DIRECT_URL for migrations and seeds.
# On Supabase (Project Settings → Database → Connection string): transaction pooler, port 6543, + "?pgbouncer=true&connect_timeout=15";
# session pooler, port 5432; or the direct connection (db.<project-ref>.supabase.co, IPv6 only). Latency of each one, measured
# from this API: docs/testes/plano-de-testes.md, section 7.
# Local dev: any Postgres, e.g.
#   docker run -d --name pg -e POSTGRES_PASSWORD=pw -e POSTGRES_DB=cardapio -p 5432:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:pw@localhost:5432/cardapio"
DIRECT_URL="postgresql://postgres:pw@localhost:5432/cardapio"
PORT=4100
# Tests only (npm test sets 3000): requests per minute per staff member. Leave unset — 600.
# STAFF_PER_MINUTE=
# Interface the API listens on. Default 127.0.0.1: only this machine reaches it.
# HOST=0.0.0.0 to test from a phone on the same Wi-Fi (dev only).
# HOST=127.0.0.1
# With NODE_ENV=production the API refuses to start unless JWT_SECRET has 32+ characters and CORS_ORIGINS is set.
# Empty in dev = an insecure built-in secret. Generate: openssl rand -base64 48
JWT_SECRET=

# Comma-separated frontend origins allowed by CORS (dashboard + cardápio URLs). Unset = any origin (dev only).
# CORS_ORIGINS=https://<painel>,https://<cardapio>   (on the VM the compose sets it: PUBLIC_URL and https://localhost)

# Supabase Storage (S3-compatible) — used for Aparência logo/cover and product photo uploads.
# Leave unset in dev if you don't need real uploads yet; the upload endpoints
# will respond 503 until these are filled in.
# Supabase dashboard: Project Settings → Storage → S3 Connection for endpoint/region,
# and create an access key pair there (not your service_role key).
# The PUBLIC bucket (e.g. cardapio): `npm run db:deploy` creates/aligns it (public, PNG/JPEG/WebP only, up to 8 MB).
STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_S3_REGION=<project-region, e.g. sa-east-1>
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_BUCKET=
# Public base URL the uploaded files are served from.
STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
# PRIVATE bucket for customers' WhatsApp photos and voice notes — never the public one above. The API stores the object key
# and hands out signed URLs valid 30–60 min. `npm run db:deploy` creates/aligns it (private, allowed types, size limit).
# Commented out on purpose: with a plain local Postgres (no Supabase `storage` schema) `db:deploy` would fail creating it.
# STORAGE_S3_WHATSAPP_BUCKET=whatsapp-media

# Super admin (/admin in the dashboard): the single key that unlocks restaurant sign-up/activation.
# Unset = /api/admin answers 503. Generate: openssl rand -base64 32
SUPER_ADMIN_KEY=

# WhatsApp in Atendimento (Evolution API, an unofficial connection), on the machine that runs the API. Start it at the repo
# root with `docker compose --env-file apps/api/.env up -d`. Any of the four unset = connecting and sending answer 503.
EVOLUTION_API_URL=http://localhost:8085
# Evolution's global key, no default: docker-compose.yml reads this same line (via --env-file) and refuses to start without it.
# Generate: openssl rand -hex 32. Changed it? `docker compose --env-file apps/api/.env up -d` recreates Evolution with it.
EVOLUTION_API_KEY=
# Where Evolution, inside Docker, posts incoming messages: this API on the host.
WHATSAPP_WEBHOOK_URL=http://host.docker.internal:4100/api/whatsapp/webhook
# Shared secret Evolution sends in the x-webhook-secret header; a webhook without it gets 401. Generate: openssl rand -hex 32
# Changed it (or the URL) with a number already connected? Disconnect and connect again so Evolution gets the new value.
WHATSAPP_WEBHOOK_SECRET=
