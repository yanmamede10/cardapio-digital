DATABASE_URL="file:./dev.db"
PORT=4100
JWT_SECRET="dev-local-only-change-before-deploying"

# Cloudflare R2 (S3-compatible) — used to store the Aparência logo/cover uploads.
# Leave unset in dev if you don't need real uploads yet; the upload endpoint
# will respond 503 until these are filled in.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL the uploaded files are served from (bucket's r2.dev URL or a custom domain).
R2_PUBLIC_URL=
