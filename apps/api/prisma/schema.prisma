datasource db {
  provider  = "postgresql"
  // Runtime: pooled (PgBouncer) connection string. Migrations: direct/session-mode.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Restaurant {
  id            String   @id
  name          String
  initials      String
  cuisine       String
  cuisineTagsJson String
  rating        Float
  reviewCount   Int
  etaMinMinutes Int
  etaMaxMinutes Int
  deliveryFee   Float
  isOpen        Boolean
  reopensAt     String?
  promoLabel    String?
  coverLabel    String
  sortOrder     Int      @default(0)

  // Management dashboard — profile / fiscal / finance config (1:1 with the
  // restaurant, so kept as plain fields rather than satellite tables).
  description       String   @default("")
  logoUrl           String?
  coverUrl          String?
  cnpj              String   @default("")
  legalName         String   @default("")
  stateRegistration String   @default("")
  taxRegime         String   @default("")
  fiscalAddress     String   @default("")
  deliveryFeeCap    Float    @default(0)
  // Mensalidade (super admin): monthly price and due day (1-28, so every month has it).
  planPrice         Float    @default(0)
  planDueDay        Int      @default(10)
  // Contracted modules (PLAN_MODULES keys) — gate the dashboard menu and API; toggled by the super admin.
  planModulesJson   String   @default("[\"pedidos\",\"cardapio\",\"mesas\",\"promocoes\",\"atendimento\",\"produtos\",\"relatorios\",\"visao\",\"pagar\",\"receber\",\"fiscal\"]")

  // How the restaurant takes payment at the table/counter: "sistema" (PIX via
  // our Asaas subconta) or "maquininha_propria" (their own card/PIX terminal —
  // we just record the method and confirm manually, no QR/webhook).
  paymentMode       String   @default("maquininha_propria")
  // Table comandas add a 10% service — optional per restaurant (Configurações → Financeiro).
  serviceCharge     Boolean  @default(true)
  // Customers order through the table's QR (or a fixed tablet). Off: only the waiter launches table orders (Lançar pedido).
  qrOrdering        Boolean  @default(true)

  // Aparência — customer-facing menu page skin. "draft*" is what the dashboard
  // edits; the plain fields below are what's actually published and served by
  // the public appearance endpoint. No versioning, just draft vs. live.
  template            String    @default("classico")
  brandColor          String    @default("#732009")
  appearanceLogoUrl   String?
  coverPhotosJson     String    @default("[]")
  appearancePublishedAt DateTime?

  draftTemplate       String    @default("classico")
  draftBrandColor     String    @default("#732009")
  draftLogoUrl        String?
  draftCoverPhotosJson String   @default("[]")

  // Mapa do salão — square grid the dashboard positions tables on (SALAO-01).
  gridSize Int @default(9)

  // Plataforma (super admin, ADMIN-01). Sign-ups start "pendente"; only "ativo" ones log in and are listed.
  status    String   @default("ativo") // "ativo" | "inativo" | "pendente"
  contact   String   @default("")
  createdAt DateTime @default(now())

  // WhatsApp no Atendimento (conexão não oficial): o Dono aceitou o aviso de risco de bloqueio — quando e quem (StaffMember.id).
  whatsappTermsAcceptedAt DateTime?
  whatsappTermsAcceptedBy String?

  categories     MenuCategory[]
  items          MenuItem[]
  orders         Order[]
  tables         RestaurantTable[]
  waiterCalls    WaiterCall[]
  coupons        Coupon[]
  tickets        SupportTicket[]
  reviews        Review[]
  staff          StaffMember[]
  operatingHours OperatingHour[]
  billingCharges BillingCharge[]
  products       Product[]
  stockMovements StockMovement[]
  financeEntries FinanceEntry[]
}

model MenuCategory {
  id           String @id
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  sortOrder    Int

  items MenuItem[]
}

model MenuItem {
  id               String @id
  restaurantId     String
  restaurant       Restaurant   @relation(fields: [restaurantId], references: [id])
  categoryId       String
  category         MenuCategory @relation(fields: [categoryId], references: [id])
  name             String
  shortDescription String
  longDescription  String
  price            Float
  photoLabel       String
  imageUrl         String?
  tag              String?
  tagIcon          String?
  soldOut          Boolean @default(false)
  optionGroupsJson String
  scheduleLabel    String  @default("Almoço 11:00 – 15:00 · Jantar 18:00 – 23:00")
  sortOrder        Int     @default(0)
  // Catalog product this dish sells. name/price above are a denormalized copy
  // kept in sync on product edit, so ordering/pricing code reads MenuItem as before.
  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
}

// Catálogo — what the restaurant sells ("produto") or consumes ("insumo").
model Product {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  type         String   // "produto" | "insumo" — fixed after creation
  unit         String   @default("un")
  price        Float    @default(0)
  // Manual cost, moved to a weighted average by XML entries. Ignored when
  // composed — then cost is the sum of the components' current cost.
  cost         Float    @default(0)
  stock        Float    @default(0)
  ncm          String   @default("")
  cst          String   @default("")
  taxRate      Float    @default(0)
  composed     Boolean  @default(false)
  createdAt    DateTime @default(now())

  components ProductComponent[] @relation("ProductComponents")
  usedIn     ProductComponent[] @relation("ComponentOf")
  menuItems  MenuItem[]
  movements  StockMovement[]
}

// Ficha técnica line: `quantity` of `component` (in its own unit) per unit of `product`.
model ProductComponent {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation("ProductComponents", fields: [productId], references: [id], onDelete: Cascade)
  componentId String
  component   Product @relation("ComponentOf", fields: [componentId], references: [id])
  quantity    Float
}

model StockMovement {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  kind         String   // "in" | "out"
  quantity     Float    // always positive; kind gives the sign
  source       String   // XML file name or "Fechamento de comanda #1234"
  createdAt    DateTime @default(now())
}

// Contas a pagar / receber. Dates are plain "YYYY-MM-DD" strings — no time or zone involved.
model FinanceEntry {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  kind          String   // "payable" | "receivable"
  description   String
  amount        Float
  dueDate       String
  status        String   @default("pending") // "pending" | "paid"
  category      String   @default("")
  costCenter    String   @default("")
  paidOn        String?
  paymentMethod String?
  createdAt     DateTime @default(now())
}

model Address {
  id        String  @id
  label     String
  detail    String
  icon      String
  isDefault Boolean @default(false)
}

model PaymentMethod {
  id    String @id
  label String
  note  String
  icon  String
}

model Order {
  id              String    @id @default(cuid())
  code            String
  mode            String
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantName  String
  tableNumber     Int?
  guestName       String?
  guestSessionId  String
  addressId       String?
  paymentMethodId String?
  couponCode      String?
  subtotal        Float
  deliveryFee     Float
  discount        Float
  total           Float
  status          String
  round           Int       @default(1)
  // Lançar pedido: the waiter who took it at the table (null = the customer ordered by QR, tablet or delivery).
  waiterName      String?
  // Table orders: when their comanda was closed (paid). The open comanda = the table's orders with no closedAt.
  closedAt        DateTime?
  // The service charged on this order, frozen when its comanda closes (0 until then, and for delivery).
  service         Float     @default(0)
  waiterCalledAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  lines OrderLine[]
}

model OrderLine {
  id                  String @id @default(cuid())
  orderId             String
  order               Order  @relation(fields: [orderId], references: [id])
  itemId              String
  name                String
  unitPrice           Float
  quantity            Int
  notes               String
  selectedOptionsJson String
  // What one unit takes from stock ({productId: quantity}), frozen when ordered: closing the comanda later takes this,
  // even if the ficha técnica changed or the dish left the Cardápio. null = ordered before it existed (reads today's).
  stockJson           String?
}

// ---------------------------------------------------------------------------
// Restaurant management dashboard — tables, coupons, support, reports, etc.
// ---------------------------------------------------------------------------

model RestaurantTable {
  id           String    @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  number       Int
  seats        Int
  openedAt     DateTime?
  gridRow      Int?
  gridCol      Int?
  // What the table's QR (and its fixed tablet) carries: /t/<qrCode>. 244 random bits from the database (migration
  // 9g_table_qr_code), base64url — the only way a customer orders for this table. "Gerar novo QR" sets it back to DEFAULT.
  qrCode       String    @unique @default(dbgenerated("translate(encode(decode(replace(gen_random_uuid()::text || gen_random_uuid()::text, '-', ''), 'hex'), 'base64'), '+/=', '-_')"))

  @@unique([restaurantId, number])
}

model WaiterCall {
  id           String    @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  tableNumber  Int
  reason       String
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
}

model Coupon {
  id               String   @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id])
  code             String
  kind             String
  value            Float
  channel          String
  validUntil       DateTime
  usageLimit       Int
  usedCount        Int      @default(0)
  active           Boolean  @default(true)
  comboItemIdsJson String?
  comboPrice       Float?

  @@unique([restaurantId, code])
}

model SupportTicket {
  id             String   @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  channel        String
  customerName   String
  refLabel       String
  status         String   @default("new")
  assignee       String?
  unreadCount    Int      @default(0)
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  // Canal "whatsapp": o contato (dígitos, ex. 5511999990000). Um ticket por contato por restaurante; null nos outros canais.
  contactPhone   String?

  messages SupportMessage[]

  @@unique([restaurantId, contactPhone])
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  from       String
  authorName String?
  text       String
  createdAt  DateTime @default(now())
  mediaType  String? // "image" | "audio" (WhatsApp)
  mediaKey   String? // its object key in the private WhatsApp bucket — the API only hands out short-lived signed URLs
  externalId String? // WhatsApp message id — a redelivered webhook never duplicates a message

  @@unique([ticketId, externalId])
}

model Review {
  id           String    @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  channel      String
  customerName String
  rating       Int
  text         String
  createdAt    DateTime  @default(now())
  reply        String?
  repliedAt    DateTime?
}

model StaffMember {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  email        String   @unique
  passwordHash String   @default("")
  // Provisional password from the super admin (sign-up or reset): the next login must replace it first.
  mustChangePassword Boolean @default(false)
  role         String
  invitedAt    DateTime @default(now())
}

model OperatingHour {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  weekday      Int
  lunch        String
  dinner       String
  isOpen       Boolean

  @@unique([restaurantId, weekday])
}

// Minha Fatura's extrato. A mensalidade has its month ("2026-09") and date = due date; the super admin generates and
// settles it. status "pending" | "paid" ("failed" legacy); overdue = pending past its date, computed on read.
model BillingCharge {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  date          DateTime
  description   String
  value         Float
  status        String
  month         String?
  paidOn        String?  // YYYY-MM-DD
  paymentMethod String?

  @@unique([restaurantId, month])
}
