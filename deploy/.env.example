# Production settings of the VM. On the VM: cp deploy/.env.example deploy/.env, fill it in, chmod 600 deploy/.env.
# Never commit deploy/.env (.gitignore covers it). docker-compose.prod.yml reads it: the API gets every line; Caddy
# PUBLIC_IP and CADDY_TLS; Evolution EVOLUTION_API_KEY; the backup DIRECT_URL.
# Not here on purpose: STAFF_PER_MINUTE (tests only), HOST/PORT/TRUSTED_PROXY/EVOLUTION_API_URL/WHATSAPP_WEBHOOK_URL (fixed
# in docker-compose.prod.yml), SEED_DEMO_PASSWORD (typed once, for deploy/deploy.sh seed-demo).

# ── The VM ──
# Its public IPv4 (Oracle Cloud → Compute → Instances → Public IP). Caddy's site address and the certificate's subject;
# the fronts and the APK call https://<this IP>.
PUBLIC_IP=
# letsencrypt: a Let's Encrypt certificate for PUBLIC_IP, renewed by Caddy. internal: Caddy's local CA (testing on a dev machine).
CADDY_TLS=letsencrypt

# ── API ──
NODE_ENV=production
# Signs the staff tokens. 32+ characters, or the API refuses to start. Generate: openssl rand -base64 48
JWT_SECRET=
# Origins allowed by CORS, comma-separated, no trailing slash: the dashboard's and the cardápio's Vercel URLs, and
# https://localhost — the origin of the dashboard inside the APK (README "APK de demonstração"). The API refuses to start
# without it.
CORS_ORIGINS=https://<painel>.vercel.app,https://<cardapio>.vercel.app,https://localhost
# The super admin key (/admin in the dashboard). Generate: openssl rand -base64 32
SUPER_ADMIN_KEY=

# ── Database: the Supabase production project (sa-east-1). Copy host and user from Supabase → Connect → "Session pooler". ──
# Runtime: the pooler in SESSION mode, port 5432, without pgbouncer=true (C-4, docs/testes/plano-de-testes.md: ~20 ms per
# query instead of ~100 ms). The API is one long-lived process, so it doesn't need transaction mode.
# connection_limit=10: in session mode each Prisma connection holds one of the pool's server connections for as long as it
# lives, and the pool is 15 on the free plan (Nano; Database → Settings → Connection pooling → Pool size), shared by ports
# 5432 and 6543 for this user. 10 for the API leaves 5 for what runs next to it: db:deploy at each deploy (1–2, while the old
# API still holds its 10), the daily pg_dump (1), and slack. Without it Prisma takes 2 × vCPUs + 1 (5 on 2 OCPUs). Raised the
# pool size in Supabase? Raise this with it, keeping ~5 free.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?connection_limit=10&connect_timeout=15
# Migrations and seeds (Prisma) and the daily pg_dump (libpq, which rejects Prisma-only options like connection_limit): the
# same session pooler. Not the direct host (db.<project-ref>.supabase.co): it's IPv6-only, and the VM's network is IPv4.
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ── Storage (Supabase → Project Settings → Storage → S3 Connection; create an S3 access key pair there, not the service_role key) ──
# deploy/deploy.sh runs db:deploy, which creates or aligns both buckets (public "cardapio": PNG/JPEG/WebP; private WhatsApp media).
STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_S3_REGION=sa-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_BUCKET=cardapio
STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/cardapio
STORAGE_S3_WHATSAPP_BUCKET=whatsapp-media

# ── WhatsApp (Evolution runs in this same compose; its URL and the webhook URL are fixed there) ──
# Evolution's global key; the API and Evolution read this same line. Generate: openssl rand -hex 32
EVOLUTION_API_KEY=
# Sent by Evolution in x-webhook-secret; a webhook without it gets 401. Generate: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=
