# Caddy on the VM (deploy/docker-compose.prod.yml): HTTPS at PUBLIC_URL, everything on one address — the cardápio
# (apps/web) at /, the dashboard at /painel/, the API at /api/. Evolution is never proxied. HTTP → HTTPS is Caddy's automatic
# redirect. Variables come from deploy/.env.
#   PUBLIC_URL  https://<the VM's public IPv4>, or https://<domain> once there is one (docs/adr/0011-fronts-no-caddy.md): the
#               site address and the certificate's subject. PUBLIC_HOST, its host alone, is set from it as Caddy starts
#               (deploy/caddy.Dockerfile).
#   CADDY_TLS   letsencrypt (default): a Let's Encrypt certificate for the IP (the "shortlived" profile, ~160 h — the only one
#               Let's Encrypt issues for IPs), renewed by Caddy on its own; internal: Caddy's local CA, to test on a dev machine
{
	# A browser opening https://<IP> sends no SNI, and inside the container Caddy would look the certificate up by the
	# container's own address. This answers those handshakes with the IP's certificate.
	default_sni {$PUBLIC_HOST}
	# Only matters for CADDY_TLS=internal: there's no system trust store to install the local CA into.
	skip_install_trust
}

(tls_letsencrypt) {
	tls {
		issuer acme {
			profile shortlived
		}
	}
}

(tls_internal) {
	tls internal
}

# One front's files, from the root its handle sets. The security headers are the ones each app's vercel.json had (the API sends
# its own: apps/api/src/app.ts). Caching: a file in Vite's assets/ is named by its content's hash, so it never changes — kept
# a year; the rest, index.html first, is checked again on every visit (no-cache: revalidated, 304 if unchanged), so a deploy
# shows up at once. A missing assets/ file falls back to index.html like any other path, and is not kept.
(front) {
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		?Cache-Control no-cache
	}
	@asset {
		path /assets/*
		file
	}
	header @asset Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

{$PUBLIC_URL} {
	import tls_{$CADDY_TLS:letsencrypt}
	# Every API route is already under /api/ (apps/api/src/app.ts): the path goes through as is. What depends on it doesn't
	# change: the healthcheck and Evolution's webhook call the API inside the compose network, and photo and media URLs are
	# Supabase Storage's.
	handle /api/* {
		reverse_proxy api:4100 {
			# The client IP the API's rate limit uses (apps/api/src/lib/rateLimit.ts, TRUSTED_PROXY = this container): always
			# the address that connected here, whatever the visitor sent in this header.
			header_up CF-Connecting-IP {remote_host}
		}
	}
	# The two fronts, built into this Caddy's image: the dashboard under /painel/, the cardápio at the root. An address the
	# app routes by itself (a reload of /painel/mesas, a table's /t/<code>) has no file: it gets its own app's index.html.
	redir /painel /painel/ permanent
	handle_path /painel/* {
		root * /srv/painel
		import front
	}
	handle {
		root * /srv/web
		import front
	}
}
