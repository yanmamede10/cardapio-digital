meta {
  name: Criar mesa
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/restaurants/{{restaurante}}/tables
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "seats": 4
  }
}

assert {
  res.status: eq 201
  res.body.number: gt 0
}

script:post-response {
  bru.setVar("mesa", res.body.number);
}

tests {
  const { validar } = require("./lib/schemas.js");

  test("corpo da resposta segue o schema mesaCriada", function () {
    expect(validar("mesaCriada", res.getBody())).to.equal("");
  });
}

docs {
  Uma mesa nova a cada execução: o primeiro pedido de mesa livre fica "aguardando" até a equipe aceitar.
}
