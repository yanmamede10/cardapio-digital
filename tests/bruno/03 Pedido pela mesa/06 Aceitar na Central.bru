meta {
  name: Aceitar na Central
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/orders/{{pedidoId}}/accept
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.status: eq pending
}

tests {
  const { validar } = require("./lib/schemas.js");

  test("corpo da resposta segue o schema pedido", function () {
    expect(validar("pedido", res.getBody())).to.equal("");
  });
}
